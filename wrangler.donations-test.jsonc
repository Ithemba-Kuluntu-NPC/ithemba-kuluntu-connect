// Local-only test configuration. Do not deploy this file or reuse its placeholder ID.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ithemba-donations-local-test",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "binding": "ASSETS", "directory": ".output/public" },
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.mjs", "**/*.js"] }],
  "d1_databases": [{
    "binding": "DONATIONS_DB",
    "database_name": "ithemba-donations-local-test",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }]
}
