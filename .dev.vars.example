# Copy to ignored .dev.vars for LOCAL TESTING ONLY. All values below are placeholders.
# Prefer a scoped restricted key; see docs/stripe-donations-setup.md for required permissions.
# sk_test_ keys remain supported; server key and publishable key must use the same mode/account.
STRIPE_SECRET_KEY="rk_test_REPLACE_FROM_ASSOCIATION_ACCOUNT"
STRIPE_PUBLISHABLE_KEY="pk_test_REPLACE_FROM_SAME_ACCOUNT"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_FROM_STRIPE_LISTEN"
STRIPE_ACCOUNT_ID="acct_REPLACE_VERIFIED_ITHEMBA_KULUNTU_EV"
DONATION_COOKIE_SECRET="REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
DONATION_SITE_ORIGIN="http://localhost:8787"
STRIPE_DONATIONS_MODE="test"
STRIPE_PAYPAL_ENABLED="false"
STRIPE_PAYPAL_RECURRING_ENABLED="false"
STRIPE_BANK_TRANSFER_ENABLED="false"
STRIPE_PORTAL_CONFIGURATION_ID="bpc_REPLACE_TEST_CONFIGURATION"
STRIPE_PORTAL_LOGIN_URL="https://billing.stripe.com/p/login/REPLACE_TEST_LOGIN"
